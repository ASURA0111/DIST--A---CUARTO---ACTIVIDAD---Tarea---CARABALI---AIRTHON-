{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "vehiculosRoute": {
        "ClusterId": "vehiculosCluster",
        "Match": {
          "Path": "/api/Vehiculo/{**catch-all}"
        }
      },
      "categoriasRoute": {
        "ClusterId": "categoriasCluster",
        "Match": {
          "Path": "/api/Categoria/{**catch-all}"
        }
      },
      "authRoute": {
        "ClusterId": "authCluster",
        "Match": {
          "Path": "/api/Auth/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "vehiculosCluster": {
        "Destinations": {
          "vehiculosDestination": {
            "Address": "http://vehiculo:8080"
          }
        }
      },
      "categoriasCluster": {
        "Destinations": {
          "categoriasDestination": {
            "Address": "http://categoria:8080"
          }
        }
      },
      "authCluster": {
        "Destinations": {
          "authDestination": {
            "Address": "http://oauthjwt:8080"
          }
        }
      }
    }
  }
}